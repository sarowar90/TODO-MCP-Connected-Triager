# Keep the build context small and keep secrets and host state out of the image.
.git
.gitignore
.dart_tool/
build/
android/
ios/
web/
windows/
linux/
macos/
test/

# Never ship the host virtualenv: it contains a platform-specific SDK build and
# is rebuilt inside the image anyway.
agent/.venv/
**/__pycache__/
*.pyc

# Third-party skills are source-available, not open source. Keep them out of
# the build context so they cannot be baked into a published image.
agent/vendor-skills/

# Agent run state: snapshots, generated tickets, scratch.
agent/workspace/outbox/
agent/workspace/.checkpoints/
agent/workspace/.test-scratch/
agent/workspace/.test-checkpoints/
agent/workspace/.claude-config/

# Anything that might carry a credential.
.env
.env.*
*.pem
*.key
